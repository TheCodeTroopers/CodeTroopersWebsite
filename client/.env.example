# Build-time variables for the React app (set these in Vercel -> Settings -> Environment Variables,
# then redeploy: Vite bakes them in at build time).

# Same Google OAuth client ID as the server's GOOGLE_CLIENT_ID. If unset, the
# "Continue with Google" button is hidden and only email/password sign-in is shown.
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
