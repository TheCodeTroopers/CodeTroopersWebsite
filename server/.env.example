# ==============================================================================
# CodeTroopers Backend Environment Configuration Template
# Copy this file to .env in the server/ directory for local development,
# or set these variables in the Vercel Project Settings (Environment Variables).
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication (Admin Console)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
ADMIN_REGISTRATION_KEY=CT_ADMIN_2026

# ------------------------------------------------------------------------------
# Supabase Configuration (Recruitment Applications Storage)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for the backend server:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Or use the anon public key if preferred:
# SUPABASE_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# Google Drive Configuration (Candidate Resume Uploads)
# ------------------------------------------------------------------------------
# CodeTroopers Drive Folder ID where applicant PDFs are stored:
GOOGLE_DRIVE_FOLDER_ID=1SaE3GfrbakynHunyvQsX1lTzgKEOaNe2

# Choose EITHER Option A (Google Service Account) OR Option B (OAuth2):

# OPTION A: Google Service Account (Recommended for CodeTroopers official setup)
# 1) Paste the full service account JSON string directly in Vercel:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}
# 2) Or specify individual keys:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=codetroopers-drive@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# 3) Or place google-credentials.json in server/ directory (gitignored)

# OPTION B: Google OAuth2 Credentials
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

